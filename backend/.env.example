# ==============================================================================
# Vybeora Backend Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real secrets or production keys to version control.
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration (Frontend origins allowed to make requests)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Leave blank to use default local SQLite in development)
# For PostgreSQL: postgresql://user:password@localhost:5432/vybeora_db
DATABASE_URL=

# Channel Layer / Redis (Leave blank to use in-memory channel layer for local dev)
# For Redis: redis://localhost:6379/1
REDIS_URL=

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media Upload Configuration
MAX_UPLOAD_SIZE_MB=500
MEDIA_ROOT_PATH=media/

# External Legal Movie Sources (Internet Archive Advanced Search & Open Catalogs)
# No API key required for public Archive.org search queries; optional S3 keys for authenticated archival requests:
INTERNET_ARCHIVE_ACCESS_KEY=
INTERNET_ARCHIVE_SECRET_KEY=
INTERNET_ARCHIVE_RATE_LIMIT_PER_MINUTE=60

